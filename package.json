{
  "name": "dsh-bili-fav-qq",
  "version": "0.3.0",
  "description": "Tencent QQ official Bot API channel adapter for dsh-bili-fav",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mswinandmc/dsh-bili-fav-qq.git"
  },
  "homepage": "https://github.com/mswinandmc/dsh-bili-fav-qq#readme",
  "bugs": {
    "url": "https://github.com/mswinandmc/dsh-bili-fav-qq/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "bilibili",
    "qqbot",
    "tencent",
    "official-api",
    "channel"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --test test/*.test.mjs"
  }
}
